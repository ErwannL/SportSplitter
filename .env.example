# Copiez ce fichier en .env (jamais commité) et remplissez les valeurs.
# Voir Docs/ORQEA_SSO.md.

# development | production
SPORTSPLITTER_ENV=development

# Secret PARTAGÉ avec Orqea (≥ 32 caractères) : sert uniquement à vérifier les jetons de passation.
# Absent ou trop court : toute connexion est refusée (SSO_DISABLED).
SPORTSPLITTER_SSO_SECRET=

# Secret PROPRE à SportSplitter (≥ 32 caractères, différent du précédent) : signe les sessions.
# Obligatoire en production ; en développement, une valeur aléatoire est tirée à chaque démarrage.
SPORTSPLITTER_SESSION_SECRET=

# Origine publique de SportSplitter (contrôle de l'en-tête Origin) et lien « Accès via Orqea ».
SPORTSPLITTER_PUBLIC_URL=http://localhost:8090
SPORTSPLITTER_ORQEA_URL=https://orqea.dev

# Développement uniquement : active POST /api/auth/dev-login (interdit en production).
SPORTSPLITTER_DEV_LOGIN=

# sub Orqea à qui attribuer l'espace créé avant les comptes (peut être posé plus tard).
SPORTSPLITTER_LEGACY_OWNER_SUB=

# Ports publiés sur 127.0.0.1 uniquement.
FRONTEND_PORT=8090
BACKEND_PORT=8001
